[project]
	description = The spacetime framework for simulations
[access]
	inheritFrom = All-Projects
[access "refs/*"]
	owner = group user/Rohan Achar (lordnahor)
[access "refs/for/refs/*"]
	read = group user/Rohan Achar (lordnahor)
	push = group user/Rohan Achar (lordnahor)
	label-Code-Review = -2..+2 group user/Rohan Achar (lordnahor)
	label-Verified = -1..+1 group user/Rohan Achar (lordnahor)
	rebase = group user/Rohan Achar (lordnahor)
	removeReviewer = group user/Rohan Achar (lordnahor)
	submit = group user/Rohan Achar (lordnahor)
[access "refs/heads/*"]
	read = group user/Rohan Achar (lordnahor)
	create = group user/Rohan Achar (lordnahor)
	push = +force group user/Rohan Achar (lordnahor)
	pushMerge = group user/Rohan Achar (lordnahor)
[access "refs/tags/*"]
	push = +force group user/Rohan Achar (lordnahor)
	pushTag = group user/Rohan Achar (lordnahor)
	pushSignedTag = group user/Rohan Achar (lordnahor)
